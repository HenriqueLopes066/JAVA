algoritimo <custo_carro>

var
custo_fabrica: real
impostos: real
distribuidor: real
Custo_final: real


inicio


escreva("digite o custo de fabrica: ")
leia(custo_fabrica)

impostos <- custo_fabrica * 0.45

custo final <- custo_fabrica + impostos

distribuidor  <- custo_final * 0.28

custo final <- custo_final + distribuidor

escreva("o custo final do carro é: ", custo final)

fimalgoritimo
