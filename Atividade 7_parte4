algoritimo <notas_aluno>

var

nome:caractere
nota1, nota2, nota3: real
soma, media: real

inicio

escreva("digite o nome do aluno: ")
leia(nome)

escreva("primeira nota: ")
leia(nota1)

escreva("segunda nota: ")
leia(nota2)

escreva(terceira nota: ")
leia(nota3)

soma <- nota1 + nota2 + nota3
media <- soma/3

escreva("Nome: ", nome)
escreva("Soma das notas: ", soma)
escreva("Média: ", media)
se (media >= 7) entao
escreva("Situação: Aprovado")
senao
se (media <= 5) entao
escreva("Situação: Reprovado")
senao
escreva("Situação: Recuperação")

fimalgoritimo
